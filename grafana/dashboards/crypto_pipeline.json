        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "crypto-pg" },
        "format": "time_series",
        "rawSql": "SELECT hour AS time, hour_close AS value FROM analytics.fct_ohlcv WHERE symbol = 'BTC' ORDER BY hour DESC LIMIT 1",
        "refId": "A"
      }]
    },
